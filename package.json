{
  "name": "basic-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "dev": "next dev --turbo",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "email:dev": "cp .env ./node_modules/react-email/dist/preview && email dev --port 3001 --dir src/auth/components/emails"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@react-email/components": "0.0.36",
    "@t3-oss/env-nextjs": "^0.10.1",
    "argon2": "^0.43.0",
    "drizzle-orm": "^0.44.2",
    "geist": "^1.4.2",
    "jose": "^6.0.11",
    "next": "^15.3.2",
    "otpauth": "^9.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.5.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.12",
    "@types/node": "^20.17.46",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-email": "4.0.7",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "pnpm@10.11.1"
}
